# --- LLM (Ollama / Llama 3.2) ---
# All graph nodes share this single local LLM configuration.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.0
OLLAMA_REQUEST_TIMEOUT=120

# --- PostgreSQL (business context + policy stores) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelx
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=sentinelx
# If set, overrides the discrete POSTGRES_* fields above.
# POSTGRES_DSN=postgresql+psycopg2://sentinelx:sentinelx@localhost:5432/sentinelx

# --- FAISS vector store (enterprise knowledge) ---
FAISS_INDEX_DIR=vectorstore/index
FAISS_EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_DOCUMENTS_DIR=vectorstore/documents

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
